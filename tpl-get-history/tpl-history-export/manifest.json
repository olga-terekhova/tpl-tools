{
  "manifest_version": 3,
  "name": "TPL Borrowing History Export",
  "version": "0.2.0",
  "description": "Exports Toronto Public Library (BiblioCommons) borrowing history to a Google Sheets web app.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://tpl.bibliocommons.com/*"],
      "js": ["lib.js", "upload.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
